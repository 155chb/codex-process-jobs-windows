{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-entry.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/hook-entry.mjs\"",
            "timeout": 10,
            "statusMessage": "Preparing native completion notification"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/threshold-context.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/threshold-context.mjs\"",
            "async": true,
            "timeout": 100
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/turn-test-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/turn-test-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Deferring completion wakeups during user input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/turn-test-hook.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/scripts/turn-test-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Checking pending completion wakeups"
          }
        ]
      }
    ]
  }
}
